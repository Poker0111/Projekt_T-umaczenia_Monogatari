Dialogue: 0,0:21:03.24,0:21:04.66,Plansza Red,,0,0,0,,Opuszki
Dialogue: 0,0:21:06.12,0:21:08.58,Plansza,,0,0,0,,{\pos(164,444)}Japo
Dialogue: 0,0:21:06.12,0:21:08.58,Plansza,,0,0,0,,{\pos(1752,444)}nia
